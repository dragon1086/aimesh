# AI Mesh Configuration

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Anthropic API Key (for PM agent - AsyncAnthropic)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Telegram group chat ID where agents post updates
TELEGRAM_GROUP_CHAT_ID=-1001234567890

# Admin user IDs allowed to issue commands (comma-separated)
ADMIN_USER_IDS=123456789

# Model settings
PM_MODEL=claude-sonnet-4-20250514
WORKER_MODEL=claude-sonnet-4-20250514

# Cost controls
MAX_TOKENS_PER_SUBTASK=100000
MAX_RETRIES_PER_SUBTASK=3
AGENT_IDLE_TIMEOUT_MINUTES=30
REVIEW_TIMEOUT_MINUTES=30
MAX_BUDGET_PER_TASK_USD=5.0

# Workspace path for coder agent git operations
WORKSPACE_PATH=./workspace
